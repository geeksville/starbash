{
  "mcpServers": {
    "debugmcp": {
      "type": "streamableHttp",
      "url": "http://localhost:3001/mcp",
      "description": "DebugMCP - AI-powered debugging assistant"
    },
    "semble": {
      "command": "poetry",
      "args": [
        "-C",
        "/workspaces/starbash",
        "run",
        "semble"
      ],
      "disabled": false,
      "autoApprove": [
        "search",
        "find_related"
      ],
      "description": "Semble - local semantic code search (search, find_related)"
    }
  }
}
